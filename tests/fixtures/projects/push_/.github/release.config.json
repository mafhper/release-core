{
  "release": {
    "title": "push_",
    "tagline": "A GitHub repository attention dashboard. Desktop, private, no cloud.",
    "language": "en",
    "image": {
      "path": "docs/images/releases/release.webp",
      "required": true,
      "granularity": "minor"
    },
    "notes": {
      "granularity": "minor"
    }
  },
  "build": {
    "package_manager": "npm",
    "node": "22",
    "rust": "stable",
    "apt": [
      "libwebkit2gtk-4.1-dev",
      "libgtk-3-dev",
      "libjavascriptcoregtk-4.1-dev",
      "libappindicator3-dev",
      "librsvg2-dev",
      "patchelf"
    ],
    "gates": ["npm ci", "npm run lint", "npm run type-check", "npm run test:ci"]
  },
  "desktop": {
    "enabled": true,
    "project_path": "."
  },
  "versions": {
    "files": [
      { "path": "src-tauri/tauri.conf.json", "format": "json", "field": "version" },
      { "path": "src-tauri/Cargo.toml", "format": "toml", "field": "package.version" }
    ]
  }
}
